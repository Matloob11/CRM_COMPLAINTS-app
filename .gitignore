# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
# Safe to commit: enables the in-browser mock API. Contains no secrets.
!frontend/.env.development
# Local Vite overrides may contain portal URLs or other private values.
frontend/.env.local
frontend/.env.*.local
*.pem
*.key
*.p12
*.pfx
*.secret
id_rsa
id_ed25519
id_ecdsa
credentials.json
**/credentials
**/.aws/

