# Copy to .env.production.local when building for the VPS.
# Nothing secret belongs in here: everything in a Vite bundle is public.

# JSON API base. Leave unset to use the default /api/v1 on the same origin.
# VITE_API_BASE=/api/v1

# Portal origin, used only to load the BX24 SDK during local development.
# In production the bootstrap HTML rendered by /bitrix/handler/ already
# includes the SDK <script>, so this stays unset.
# VITE_BITRIX_PORTAL=https://crm.a7grouprealestatedxb.com
