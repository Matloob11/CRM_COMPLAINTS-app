# A7 Complaints — environment template
# Copy to `.env` on the application host (mode 0600) and fill real values.
# Never commit a filled copy. Nothing in this file is a live secret.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=complaints.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://complaints.example.com,https://crm.example.com
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=complaints
POSTGRES_USER=complaints
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=complaints-postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://complaints-redis:6379/0

# ---------------------------------------------------------------------------
# Bitrix24 local app
# ---------------------------------------------------------------------------
BITRIX_PORTAL_URL=https://crm.example.com
BITRIX_EXPECTED_MEMBER_ID=
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# Comma-separated Bitrix user ids that receive the admin role.
COMPLAINTS_ADMIN_BITRIX_IDS=

# ---------------------------------------------------------------------------
# Application JWT (minted by /bitrix/handler/, not a Bitrix token)
# ---------------------------------------------------------------------------
COMPLAINTS_JWT_SECRET=change-me-to-a-long-random-string
COMPLAINTS_JWT_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Uploads / media
# ---------------------------------------------------------------------------
COMPLAINTS_MEDIA_ROOT=/app/media
COMPLAINTS_USE_X_ACCEL_REDIRECT=true
# Production container bind-mount. Locally, omit this and Django reads ./dist.
COMPLAINTS_FRONTEND_DIST=/app/frontend-dist

# ---------------------------------------------------------------------------
# Optional outbound notifications
# ---------------------------------------------------------------------------
COMPLAINTS_N8N_WEBHOOK_URL=
COMPLAINTS_N8N_WEBHOOK_SECRET=
