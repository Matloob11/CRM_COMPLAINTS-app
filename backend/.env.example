# Local backend development only.
# Copy to backend/.env. Do not use production values on a developer machine.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=complaints
POSTGRES_USER=complaints
POSTGRES_PASSWORD=complaints
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

BITRIX_PORTAL_URL=https://crm.example.com
BITRIX_EXPECTED_MEMBER_ID=
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
COMPLAINTS_ADMIN_BITRIX_IDS=

COMPLAINTS_JWT_SECRET=dev-only-jwt-not-for-production
COMPLAINTS_USE_X_ACCEL_REDIRECT=false
COMPLAINTS_FRONTEND_DIST=../frontend/dist
